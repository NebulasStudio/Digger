{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sandsunder.invalid/v1/match-result.schema.json",
  "title": "Signed match result",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  },
  "$defs": {
    "masteryReward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "xp"],
      "properties": {
        "character_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "xp": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id", "account_id", "build_id", "ruleset_version", "placement",
        "outcome", "account_xp", "mastery", "milestones", "kills",
        "duration_seconds", "completed_at", "issued_at", "nonce"
      ],
      "properties": {
        "match_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "account_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "build_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "ruleset_version": { "$ref": "common.schema.json#/$defs/identifier" },
        "placement": { "type": "integer", "minimum": 1, "maximum": 6 },
        "outcome": {
          "type": "string",
          "enum": ["ritual", "relic", "last_survivor", "timeout", "eliminated"]
        },
        "account_xp": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "mastery": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/masteryReward" }
        },
        "milestones": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        },
        "kills": { "type": "integer", "minimum": 0, "maximum": 5 },
        "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "completed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "issued_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "nonce": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    }
  }
}
