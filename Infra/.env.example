# Local development only. Copy to Infra/.env; never reuse these values outside a workstation.
POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=local_only_replace_me
NAKAMA_IMAGE=registry.heroiclabs.com/heroiclabs/nakama:3.37.0
POSTGRES_IMAGE=postgres:16.8-alpine
NODE_IMAGE=node:22.18.0-alpine3.22
ALPINE_IMAGE=alpine:3.22.1
NAKAMA_LOG_LEVEL=DEBUG
NAKAMA_SESSION_TOKEN_EXPIRY_SEC=7200
SANDSUNDER_MATCH_HMAC_SECRET=local_only_replace_with_at_least_32_random_characters
