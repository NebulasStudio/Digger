# Source-control and local agent metadata
.git
.git/**
.codex
.codex/**
.github
.github/**

# Secrets and local overrides (examples remain available to reviewed Dockerfiles)
**/.env
**/.env.*
!**/.env.example
**/*.local
**/*.secret
**/*.secrets
**/secrets
**/secrets/**
**/.dev.vars
**/docker-compose.override.yml

# Dependencies, caches, editor state, and test output
**/node_modules
**/node_modules/**
**/.npm
**/.npm/**
**/.npm-cache
**/.npm-cache/**
**/.pnpm-store
**/.pnpm-store/**
**/.cache
**/.cache/**
**/.tmp
**/.tmp/**
**/.wrangler
**/.wrangler/**
**/.wrangler-config
**/.wrangler-config/**
**/.vs
**/.vs/**
**/.idea
**/.idea/**
**/.vscode
**/.vscode/**
**/coverage
**/coverage/**
**/TestResults
**/TestResults/**

# Generated backend/client artifacts are rebuilt inside images
**/dist
**/dist/**
**/bin
**/bin/**
**/obj
**/obj/**

# Unity-generated state and builds; retain only the packaged Linux server input
Game/Library
Game/Library/**
Game/Logs
Game/Logs/**
Game/Temp
Game/Temp/**
Game/UserSettings
Game/UserSettings/**
Game/Build
Game/Build/**
Game/Builds/*
!Game/Builds/LinuxServer
!Game/Builds/LinuxServer/**

# Private or bulky material must never enter an image context
artifacts
artifacts/**
replays
replays/**
reports
reports/**
Design/provenance/private
Design/provenance/private/**
**/*.pdb
**/*.stackdump
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz

