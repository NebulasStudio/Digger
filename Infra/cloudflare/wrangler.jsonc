{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandsunder-public-assets",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_ASSETS",
      "bucket_name": "sandsunder-public-assets-placeholder",
      "preview_bucket_name": "sandsunder-public-assets-preview-placeholder"
    }
  ]
}

