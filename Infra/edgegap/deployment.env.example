SANDSUNDER_ENVIRONMENT=staging
SANDSUNDER_BUILD_ID=replace_with_immutable_build_id
SANDSUNDER_RULESET_VERSION=0.1.0
SANDSUNDER_PORT=7777
SANDSUNDER_MAX_PLAYERS=6
SANDSUNDER_MATCH_MAX_SECONDS=900
SANDSUNDER_SHUTDOWN_GRACE_SECONDS=60

# Inject actual values using Edgegap secret/environment configuration.
NAKAMA_ENDPOINT=https://nakama.example.invalid
NAKAMA_SERVER_KEY=replace_via_edgegap_secret
PHOTON_APP_ID=replace_via_edgegap_secret
MATCH_RESULT_SIGNING_KEY=replace_via_edgegap_secret
SENTRY_DSN=replace_via_edgegap_secret

